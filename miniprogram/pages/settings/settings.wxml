<view class="page-settings">
  <view class="card">
    <view class="card-title">服务器</view>
    <view class="field">
      <text class="field-label">API 地址</text>
      <input class="input" placeholder="http://127.0.0.1:8000" value="{{api_base}}" data-field="api_base" bindinput="onInput" />
    </view>
    <view class="row row-between form-line">
      <text>默认开启提示</text>
      <switch checked="{{hints_on}}" bindchange="onHintsChange" color="#e8b33b" />
    </view>
  </view>

  <view class="card">
    <view class="card-title">LLM 讲解（可选）</view>
    <view class="field">
      <text class="field-label">base_url</text>
      <input class="input" placeholder="留空则不使用 LLM" value="{{llm_base_url}}" data-field="llm_base_url" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="field-label">api_key</text>
      <input class="input" password="{{true}}" placeholder="API Key" value="{{llm_api_key}}" data-field="llm_api_key" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="field-label">model</text>
      <input class="input" placeholder="模型名" value="{{llm_model}}" data-field="llm_model" bindinput="onInput" />
    </view>
  </view>

  <view class="card">
    <button class="btn btn-primary btn-block" bindtap="onSave">保存</button>
    <view class="muted note">开发者工具需勾选「不校验合法域名」；真机需 HTTPS（Phase 9）</view>
  </view>
</view>
