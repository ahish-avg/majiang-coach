.practice-page {
  padding-bottom: 60rpx;
}

.loading-card {
  text-align: center;
  margin-top: 200rpx;
}

/* 阶段横幅 */
.phase-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin: 20rpx 24rpx 10rpx;
  padding: 16rpx 24rpx;
}
.phase-hint {
  margin-left: 16rpx;
}
.btn-coach {
  padding: 10rpx 28rpx;
  font-size: 26rpx;
  background-color: transparent;
  color: #f5f1e6;
  border: 2rpx solid rgba(245, 241, 230, 0.7);
}
.btn-coach::after {
  border: none;
}

/* 中央操作槽 */
.action-bar {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}
.action-hand {
  margin-bottom: 12rpx;
}
.action-hint {
  text-align: center;
  margin-bottom: 12rpx;
}
.action-btn {
  margin-top: 0;
}
.btn[disabled] {
  opacity: 0.5;
}

.btn-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: center;
}
.btn-grid .btn {
  margin: 6rpx;
}
.btn-ghost {
  background-color: transparent;
  color: #f5f1e6;
  border: 2rpx solid rgba(245, 241, 230, 0.7);
}
.btn-ghost::after {
  border: none;
}

.claim-info {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
}

/* 教练建议面板 */
.advise-card {
  margin-top: 16rpx;
}
.advise-line {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin: 10rpx 0;
}
.advise-label {
  color: #ffd66b;
  font-weight: 600;
  margin-right: 10rpx;
}
.advise-item {
  margin: 10rpx 0;
  line-height: 1.6;
}
.advise-error {
  margin: 10rpx 0;
}

/* 结算 */
.settle-card {
  margin-top: 24rpx;
}
.settle-title {
  font-size: 40rpx;
  font-weight: 800;
  text-align: center;
  margin-bottom: 12rpx;
}
.settle-tag {
  display: block;
  width: fit-content;
  margin: 0 auto 16rpx;
  font-size: 26rpx;
}
.settle-head-tag {
  margin-left: 12rpx;
}
.settle-line {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
  margin: 8rpx 0;
  line-height: 1.6;
}
.settle-seat {
  font-weight: 700;
  margin-right: 8rpx;
}
.settle-strong {
  font-weight: 600;
}
.settle-block {
  border-top: 2rpx solid rgba(245, 241, 230, 0.2);
  padding-top: 12rpx;
  margin-top: 16rpx;
}
.settle-sub {
  font-weight: 700;
  color: #ffd66b;
  margin-bottom: 8rpx;
}
.fan-line {
  margin: 4rpx 0;
}
.fan-basis {
  margin-left: 8rpx;
}
.seed-line {
  margin-top: 16rpx;
  text-align: center;
}
.wait-tiles {
  margin: 0 8rpx;
}

.score-table {
  margin-top: 20rpx;
  border-top: 2rpx solid rgba(245, 241, 230, 0.3);
  padding-top: 12rpx;
}
.score-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 12rpx;
}
.score-total {
  border-top: 2rpx dashed rgba(245, 241, 230, 0.3);
  margin-top: 8rpx;
  font-weight: 700;
}
.score-val {
  font-size: 32rpx;
  font-weight: 700;
}
.score-pos {
  color: #ff6b6b;
}
.score-neg {
  color: #8be0a0;
}
