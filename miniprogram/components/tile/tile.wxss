.tile {
  width: 56rpx;
  height: 80rpx;
  border-radius: 6rpx;
  background-color: #fbf7ec;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.4);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin: 4rpx;
  transition: transform 0.1s ease, box-shadow 0.1s ease;
  box-sizing: border-box;
}
.tile-img {
  width: 100%;
  height: 100%;
}
.tile.small {
  width: 36rpx;
  height: 52rpx;
  margin: 2rpx;
}
.tile.sel {
  transform: translateY(-14rpx);
  box-shadow: 0 0 0 3rpx #e8b33b, 0 6rpx 10rpx rgba(0, 0, 0, 0.45);
}
.tile.hl {
  box-shadow: 0 0 12rpx 4rpx rgba(232, 179, 59, 0.95), 0 0 0 3rpx #e8b33b;
}
