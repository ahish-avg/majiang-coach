# Phase 1 暂无密钥。以下为 Phase 4 (LLM) 预留的配置结构占位。
# 复制本文件为 .env 并填入真实值后使用(切勿提交 .env)。

# LLM 接入 (Phase 4)
# 三项齐全才启用 LLM 提示;缺一则 advise 降级为硬算 analysis(见 llm/config.py)。
# 支持 OpenAI 兼容接口(DeepSeek/豆包/本地等);也可在请求体 llm:{...} 每请求覆盖。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 可选(留空用默认):temperature=0.3, timeout=30.0
LLM_TEMPERATURE=
LLM_TIMEOUT=

# API 服务 (Phase 1 demo)
API_HOST=127.0.0.1
API_PORT=8000
